<!DOCTYPE html>
<html>
<head><meta charset="utf-8"/><title>Edit Invitation</title><meta name="viewport" content="width=device-width, initial-scale=1" /><link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&display=swap" rel="stylesheet"><link rel="stylesheet" href="/style.css"/></head>
<body>
  <div class="container">
    <header class="header"><a class="brand" href="/admin"><div class="logo">I</div><div><h1>Edit Invitation</h1><p class="small">Admin</p></div></a><div><a class="btn" href="/admin/invitations">Back to list</a></div></header>
    <main class="card" style="max-width:900px;margin:0 auto">
      <p>Client private URL: <a href="<%= clientUrl %>" target="_blank"><%= clientUrl %></a></p>
      <form method="POST" action="/admin/edit/<%= invite._id %>">
        <label>Title: <input class="input" name="title" required value="<%= invite.title %>"></label>
        <label>Slug: <input class="input" name="slug" required value="<%= invite.slug %>"></label>
        <label>Host / Names: <input class="input" name="hostName" value="<%= invite.hostName %>"></label>
        <div class="row"><div class="col"><label>Date: <input class="input" type="date" name="date" value="<%= invite.date ? invite.date.toISOString().substr(0,10) : '' %>"></label></div><div class="col"><label>Time: <input class="input" name="time" value="<%= invite.time || '' %>"></label></div></div>
        <label>Venue: <input class="input" name="venue" value="<%= invite.venue || '' %>"></label>
        <label>Message: <textarea class="input" name="message"><%= invite.message || '' %></textarea></label>
        <div class="row"><div class="col"><label>Template: <input class="input" name="templateName" value="<%= invite.templateName || 'classic1' %>"></label></div><div class="col"><label>Theme color: <input class="input" name="themeColor" value="<%= invite.meta?.themeColor || '' %>"></label></div></div>
        <label>Cover Image URL: <input class="input" name="coverImage" value="<%= invite.meta?.coverImage || '' %>"></label>
        <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:12px"><a class="btn ghost" href="/admin/invitations">Cancel</a><button class="btn" type="submit">Save</button></div>
      </form>
    </main>
  </div>
</body>
</html>
