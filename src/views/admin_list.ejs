<!DOCTYPE html>
<html>
<head><meta charset="utf-8"/><title>Invitations (Admin)</title><meta name="viewport" content="width=device-width, initial-scale=1" /><link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&display=swap" rel="stylesheet"><link rel="stylesheet" href="/style.css"/></head>
<body>
  <div class="container">
    <header class="header">
      <a class="brand" href="/admin"><div class="logo">I</div><div><h1>Admin</h1><p class="small">Invitations</p></div></a>
      <div style="display:flex; gap:10px"><a class="btn" href="/admin">Dashboard</a><a class="btn ghost" href="/">Go to Main Site</a></div>
    </header>
    <main class="card">
      <div style="display:flex;justify-content:space-between;align-items:center"><h3>All Invitations</h3><a class="btn" href="/admin/invitations">Refresh</a></div>
      <div class="table-wrap mt-12">
        <table class="table">
          <thead><tr><th>Title</th><th>Slug</th><th>Owner</th><th>Created</th><th>Actions</th></tr></thead>
          <tbody>
            <% if (!invitations || invitations.length === 0) { %><tr><td colspan="5">No invitations found.</td></tr><% } %>
            <% invitations.forEach(inv => { %>
              <tr>
                <td><strong><%= inv.title %></strong></td>
                <td>/i/<%= inv.slug %></td>
                <td><% if (inv.owner) { %><%= inv.owner.name || inv.owner.email %><br/><span class="small"><%= inv.owner.email %></span><% } else { %><span class="small">—</span><% } %></td>
                <td><%= new Date(inv.createdAt).toLocaleString() %></td>
                <td><a class="action-link" href="/i/<%= inv.slug %>" target="_blank">View</a> <a class="action-link" href="/admin/edit/<%= inv._id %>">Edit</a>
                  <form style="display:inline" method="POST" action="/admin/delete/<%= inv._id %>" onsubmit="return confirm('Delete invite?')"><button class="delete-btn" type="submit">Delete</button></form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </main>
  </div>
</body>
</html>
