<!DOCTYPE html>
<html>
<head><meta name="viewport" content="width=device-width, initial-scale=1" />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/style.css" />

  <meta charset="utf-8"/><title>Client Dashboard</title><link rel="stylesheet" href="/style.css"/></head>
<body>
  <h1>Client Dashboard</h1>
  <% if (message) { %><p style="color:green"><%= message %></p><% } %>
  <% if (error) { %><p style="color:red"><%= error %></p><% } %>

  <% if (invite) { %>
    <p>Public invite page: <a href="/i/<%= invite.slug %>" target="_blank">/i/<%= invite.slug %></a></p>

    <form method="POST" action="/client/<%= invite.slug %>/<%= invite.meta.accessKey %>">
      <label>Title: <input name="title" required value="<%= invite.title %>"></label><br/>
      <label>Date: <input type="date" name="date" value="<%= invite.date ? invite.date.toISOString().substr(0,10) : '' %>"></label><br/>
      <label>Time: <input name="time" value="<%= invite.time || '' %>"></label><br/>
      <label>Venue: <input name="venue" value="<%= invite.venue || '' %>"></label><br/>
      <label>Message: <textarea name="message"><%= invite.message || '' %></textarea></label><br/>
      <label>Cover Image URL: <input name="coverImage" value="<%= invite.meta.coverImage || '' %>"></label><br/>
      <label>Theme Color: <input name="themeColor" value="<%= invite.meta.themeColor || '' %>"></label><br/>
      <button type="submit">Save changes</button>
    </form>
  <% } else { %>
    <p>Invitation not found or invalid access key.</p>
  <% } %>
</body>
</html>
