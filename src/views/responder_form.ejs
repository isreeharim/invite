<!DOCTYPE html>
<html>
<head><meta charset="utf-8"/><title>Respond — <%= invite.title %></title><meta name="viewport" content="width=device-width, initial-scale=1" /><link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&display=swap" rel="stylesheet"><link rel="stylesheet" href="/style.css"/></head>
<body>
  <div class="container">
    <main class="card" style="max-width:680px;margin:0 auto">
      <h2>Respond to <%= invite.title %></h2>
      <% if (error) { %><p style="color:#ffb4b4"><%= error %></p><% } %>
      <form method="POST" action="/r/<%= invite.slug %>">
        <label>Name <input class="input" name="name" required></label>
        <label>Email <input class="input" name="email" type="email"></label>
        <label>Phone <input class="input" name="phone"></label>
        <div class="row">
          <div class="col">
            <label>Status <select class="input" name="status"><option value="yes">Yes</option><option value="maybe">Maybe</option><option value="no">No</option></select></label>
          </div>
          <div class="col">
            <label>People <input class="input" name="guestsCount" type="number" min="1" value="1"></label>
          </div>
        </div>
        <label>Message <textarea class="input" name="message"></textarea></label>
        <div style="display:flex;justify-content:flex-end"><button class="btn" type="submit">Send RSVP</button></div>
      </form>
    </main>
  </div>
</body>
</html>
