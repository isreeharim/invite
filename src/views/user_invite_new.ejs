<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8"/>
  <title>Create Invite</title>
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css"/>
</head>
<body>
  <div class="container">
    <header class="header">
      <a class="brand" href="/dashboard">
        <div class="logo">I</div>
        <div>
          <h1>Create invite</h1>
          <p class="small">Make a personalized page</p>
        </div>
      </a>
      <div>
        <form method="POST" action="/logout">
          <button class="btn ghost" type="submit">Logout</button>
        </form>
      </div>
    </header>

    <main class="card" style="max-width:900px;margin:0 auto">
      <% if (error) { %>
        <p style="color:#ffb4b4"><%= error %></p>
      <% } %>

      <form method="POST" action="/invites/new" class="form" enctype="multipart/form-data">
        <div class="row">
          <div class="col">
            <label>Title 
              <input class="input" name="title" required value="<%= values.title || '' %>">
            </label>
          </div>
          <div class="col">
            <label>Slug 
              <input class="input" name="slug" value="<%= values.slug || '' %>">
            </label>
          </div>
        </div>

        <label>Host / Names 
          <input class="input" name="hostName" value="<%= values.hostName || '' %>">
        </label>

        <div class="row">
          <div class="col">
            <label>Date 
              <input class="input" type="date" name="date" value="<%= values.date || '' %>">
            </label>
          </div>
          <div class="col">
            <label>Time 
              <input class="input" name="time" value="<%= values.time || '' %>">
            </label>
          </div>
        </div>

        <label>Venue 
          <input class="input" name="venue" value="<%= values.venue || '' %>">
        </label>

        <label>Message 
          <textarea class="input" name="message"><%= values.message || '' %></textarea>
        </label>

        <label>Template 
          <input class="input" name="templateName" value="<%= values.templateName || 'classic1' %>">
        </label>

        <label>Cover image URL (optional)</label>
        <input class="input" name="coverImage" value="<%= values.coverImage || '' %>" placeholder="http://example.com/image.jpg">

        <label style="margin-top:8px">
          Or choose a file (image) — Max 5MB
        </label>
        <input class="input" type="file" name="coverImage" accept="image/*">

        <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:12px">
          <a class="btn ghost" href="/dashboard">Cancel</a>
          <button class="btn" type="submit">Create invite</button>
        </div>
      </form>
    </main>
  </div>
</body>
</html>
